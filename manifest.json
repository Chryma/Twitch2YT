{
  "manifest_version": 3,
  "name": "Twitch to YouTube",
  "version": "1.0",
  "description": "Swaps a Twitch stream for the streamer's YouTube live.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://www.twitch.tv/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.twitch.tv/*"
      ],
      "js": [
        "content.js"
      ]
    },
    {
      "matches": [
        "https://www.youtube.com/embed/*"
      ],
      "js": [
        "embed.js"
      ],
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}
